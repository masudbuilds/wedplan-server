# Server Configuration
PORT=5000

# MongoDB Configuration
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority
DB_NAME=wedplan

# Client URL (for CORS, supports comma-separated origins)
# Production example: CLIENT_URL=https://wedplan-client-pearl.vercel.app
CLIENT_URL=http://localhost:3000

# Better Auth JWT Verification
# Production example: BETTER_AUTH_JWKS_URL=https://wedplan-client-pearl.vercel.app/api/auth/jwks
BETTER_AUTH_JWKS_URL=http://localhost:3000/api/auth/jwks

# Production example: BETTER_AUTH_ISSUER=https://wedplan-client-pearl.vercel.app
BETTER_AUTH_ISSUER=http://localhost:3000

# Stripe Configuration
# Production example: STRIPE_SECRET_KEY=sk_test_... or sk_live_...
STRIPE_SECRET_KEY=sk_test_placeholder
# Production example: STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_WEBHOOK_SECRET=whsec_placeholder
# Production example: STRIPE_PRICE_ID=price_...
STRIPE_PRICE_ID=price_placeholder

# ImgBB API Key
IMGBB_API_KEY=placeholder_imgbb_key
